HTTP_ADDR=:18080
POSTGRES_DSN=postgres://sm:sm@127.0.0.1:15432/sharedmemory?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=smminio
MINIO_SECRET_KEY=smminio_secret
MINIO_BUCKET=shared-memory
OPENSEARCH_URL=http://127.0.0.1:19200
QDRANT_URL=http://127.0.0.1:16333
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
# Local embedding model from the compose stack; leave empty for the offline hash embedder.
EMBEDDER_URL=http://127.0.0.1:18081
# Tesseract languages for image OCR; needs tesseract on PATH (the worker image ships it).
OCR_LANGS=
# Optional OpenAI-compatible chat API for semantic derive (falls back to heuristic on error).
# LLM_DERIVER_URL=https://api.openai.com/v1
# LLM_DERIVER_API_KEY=
# LLM_DERIVER_MODEL=gpt-4o-mini
# Optional multimodal vision for image attachments (account policy cloud_vision_enabled can disable).
# VISION_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=gpt-4o-mini
