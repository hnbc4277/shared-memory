HTTP_ADDR=:18080
POSTGRES_DSN=postgres://sm:sm@127.0.0.1:15432/sharedmemory?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=smminio
MINIO_SECRET_KEY=smminio_secret
MINIO_BUCKET=shared-memory
OPENSEARCH_URL=http://127.0.0.1:19200
QDRANT_URL=http://127.0.0.1:16333
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
# Externally reachable API base (REQUIRED for company PCs / port mapping).
# Written into setup-script zip + returned by GET /v1/me as public_api_url for console guides.
# Example: http://your.domain:28080  — leave empty to fall back to http://127.0.0.1:18080 in scripts.
# PUBLIC_API_URL=http://127.0.0.1:18080
# Device verification_uri in POST /v1/device/code (match your Web console URL)
# SHARED_MEMORY_WEB_URL=http://127.0.0.1:15173
# Optional: serve built web console from API (path to web/dist)
# WEB_STATIC_DIR=web/dist
# Deployment-default embedder (account override is configured in Web Settings).
# Leave EMBEDDER_URL empty for the offline hash embedder.
EMBEDDER_URL=http://127.0.0.1:18081
# EMBEDDER_PROTOCOL=tei
# EMBEDDER_MODEL=bge-small-zh-v1.5
# EMBEDDER_DIM=512
# EMBEDDER_API_KEY=
# EMBEDDER_MAX_DIM=4096
# Spec: [internal-notes]
# Tesseract languages for image OCR; needs tesseract on PATH (the worker image ships it).
OCR_LANGS=
# Optional OpenAI-compatible chat API for semantic derive (falls back to heuristic on error).
# LLM_DERIVER_URL=https://api.openai.com/v1
# LLM_DERIVER_API_KEY=
# LLM_DERIVER_MODEL=gpt-4o-mini
# Optional multimodal vision for image attachments (account policy cloud_vision_enabled can disable).
# VISION_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=gpt-4o-mini

# Recall receipt retention (worker hourly purge); default 30
# RECALL_RECEIPT_RETENTION_DAYS=30

# Optional: bind ingest/recall to a Web「智能体」registered connection (MCP / hook / smctl install).
# SHARED_MEMORY_CONNECTION_ID=

# Agent online thresholds (智能体 Tab): default 90s heartbeat, 15min activity
# AGENT_HEARTBEAT_ONLINE_SEC=90
# AGENT_ACTIVITY_ONLINE_MIN=15

# Rate limits (Redis required; 0 disables that bucket)
# RATE_LIMIT_PER_MIN=120
# AUTH_RATE_LIMIT_PER_MIN=20
# AUTH_EMAIL_RATE_LIMIT_PER_MIN=10
