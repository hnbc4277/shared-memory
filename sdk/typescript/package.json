{
  "name": "@sharedmemory/sdk",
  "version": "0.1.0",
  "description": "Shared Memory HTTP client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
