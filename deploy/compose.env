# Config for the api/worker containers (compose profile "app"); hosts are
# service names on sharedmemory_net. Replace VAULT_MASTER_KEY outside local dev.
HTTP_ADDR=:18080
POSTGRES_DSN=postgres://sm:sm@postgres:5432/sharedmemory?sslmode=disable
REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=smminio
MINIO_SECRET_KEY=smminio_secret
MINIO_BUCKET=shared-memory
OPENSEARCH_URL=http://opensearch:9200
QDRANT_URL=http://qdrant:6333
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173,http://127.0.0.1:18080,http://localhost:18080
# Client-reachable API root (guides + setup zip). Remote clients: set host:port in local override / env.
PUBLIC_API_URL=http://127.0.0.1:18080
EMBEDDER_URL=http://embedder:80
OCR_LANGS=chi_sim+eng
