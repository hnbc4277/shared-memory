{
  "name": "@sharedmemory/openclaw-plugin",
  "version": "0.1.0",
  "description": "OpenClaw (xiaolongxia) plugin for Shared Memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sharedmemory/sdk": "file:../../sdk/typescript"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"]
  }
}
